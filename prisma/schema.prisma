generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  authUserId String   @unique // THIS IS THE BRIDGE: The MongoDB User ID goes here!
  email      String   @unique
  name       String?
  
  // --- CORE LOGIC: Fields For Onboarding ---
  industry   String?  // Example: Tech, Finance
  experience Int?     // Number of years (Int = Integer/Number)
  bio        String?  // A short professional summary
  skills     String[] // A dynamic list of skills like ["React", "Python"]
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  resumes    Resume[] // A user can have many resumes
}

model Resume {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("My Resume")
  
  firstName String?
  lastName  String?
  email     String?
  phone     String?
  linkedin  String?
  summary   String?

  experiences Experience[]
  educations  Education[]
  skills      Skill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Experience {
  id          String   @id @default(uuid())
  resumeId    String
  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobTitle    String
  company     String
  startDate   String?
  endDate     String?
  description String?
}

model Education {
  id           String   @id @default(uuid())
  resumeId     String
  resume       Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  degree       String
  institution  String
  startDate    String?
  endDate      String?
}

model Skill {
  id       String   @id @default(uuid())
  resumeId String
  resume   Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  name     String
}